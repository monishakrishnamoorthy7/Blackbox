PORT=4000
# Neon (Postgres) connection string — from your Neon project's Connection Details.
# Include ?sslmode=require, Neon requires TLS.
DATABASE_URL=postgresql://user:password@ep-example-000000.region.aws.neon.tech/bike_black_box?sslmode=require
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_LEDGER_PATH=./data/evidence-ledger.jsonl
BLOCKCHAIN_RETRY_ENABLED=true
BLOCKCHAIN_MAX_RETRIES=5
BLOCKCHAIN_RETRY_INTERVAL_MS=5000
# Informational only: the SW-420 is wired to the ESP32-S3 (see firmware/),
# not to this server. Set this to whatever GPIO the firmware uses so the
# dashboard's Settings/Vehicles pages report the real pin instead of "not configured".
VIBRATION_SENSOR_PIN=GPIO5
